{
  "name": "machina-ide",
  "version": "0.2.0-beta.1",
  "private": true,
  "author": "Machina IDE Contributors",
  "description": "Machina IDE prerelease engineering workspace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TararaDotJoshua/Machina_IDE.git"
  },
  "homepage": "https://github.com/TararaDotJoshua/Machina_IDE",
  "bugs": {
    "url": "https://github.com/TararaDotJoshua/Machina_IDE/issues"
  },
  "main": "out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:plugins && electron-vite dev",
    "build": "npm run typecheck && npm run test && npm run build:plugins && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build:plugins": "node scripts/build-plugins.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:plugins && vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "semver": "^7.7.2",
    "three": "^0.179.1",
    "zustand": "^5.0.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.machina.ide",
    "productName": "Machina IDE",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist/plugin-runtime", "to": "plugin-runtime" }
    ],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
