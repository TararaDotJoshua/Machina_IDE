{
  "name": "machina-ide",
  "version": "1.0.0-beta.6",
  "private": true,
  "author": "Machina IDE Contributors",
  "description": "Desktop-first engineering workspace for mechatronics projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TararaDotJoshua/Machina_IDE.git"
  },
  "homepage": "https://github.com/TararaDotJoshua/Machina_IDE",
  "bugs": {
    "url": "https://github.com/TararaDotJoshua/Machina_IDE/issues"
  },
  "main": "out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:plugins && electron-vite dev",
    "build": "npm run typecheck && npm run test && npm run build:plugins && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:beta": "npm run build && electron-builder --win nsis --publish always",
    "build:plugins": "node scripts/build-plugins.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:plugins && vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "semver": "^7.7.2",
    "three": "^0.179.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.7.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "occt-import-js": "^0.0.23",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.machina.ide",
    "productName": "Machina IDE",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/plugin-runtime",
        "to": "plugin-runtime"
      },
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/manifest.json",
          "**/README.md",
          "**/LICENSE*",
          "**/dist/**"
        ]
      },
      {
        "from": "marketplace",
        "to": "marketplace",
        "filter": ["catalog.json"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "TararaDotJoshua",
      "repo": "Machina_IDE",
      "channel": "beta",
      "releaseType": "prerelease"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Machina-IDE-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
